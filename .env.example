# ============================================================
# docker-compose 部署环境变量
# ============================================================

# MySQL root 密码
MYSQL_ROOT_PASSWORD=root1234

# Elasticsearch（外部云实例，不在 compose 内启动）
# 多个地址用英文逗号分隔；留空时相关服务仍可启动，但读写 ES 的功能不可用
ES_ADDRESSES=https://your-es-host:443,
ES_API_KEY=

# 若启用 docker-compose.yml 中注释掉的本地 Elasticsearch，改用下面两行：
# ES_ADDRESSES=http://elasticsearch:9200
# ES_API_KEY=

# 是否输出调试日志
DEBUG_MODE=false
